%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_Script: {fileID: 11500000, guid: 058c568ea472e2241a4bd7edf1d50fce, type: 3}
  m_Name: Interview
  m_EditorClassIdentifier:
  lines:
  - speaker: "Главный герой"
    text: "Что происходит, сэр? Вы нашли отца?"
    eventId:
  - speaker: "Шеф"
    text: "Твоего отца видели на портовом складе вчера ночью. Там, где мы нашли следы химикатов и самодельной взрывчатки. Я не знаю, чем он там занимался. Но ФБР уже в курсе. И они хотят повесить это дело на нас."
    eventId:
  - speaker: "Главный герой"
    text: "Это ошибка. Мой отец ветеран, он не..."
    eventId:
  - speaker: "Шеф"
    text: "Именно! Ветеран Афганистана, бывший военный. Ты знаешь, что у него в гараже? Мы проверили. Там нашли следы химикатов. А ещё — карту города с отметками. Всё это намекает на его связь с террористами. Мне не нужны проблемы. Поэтому с этой минуты ты отстранён от службы."
    eventId:
