%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_Script: {fileID: 11500000, guid: 058c568ea472e2241a4bd7edf1d50fce, type: 3}
  m_Name: Interview
  m_EditorClassIdentifier:
  lines:
  - speaker: "Шеф"
    text: "Ты думал, это обычное задержание? Я читал рапорт."
    eventId:
  - speaker: "Шеф"
    text: "Он назвал твоего старика. Дважды. Второй раз — когда решил, что диктофон выключен."
    eventId:
  - speaker: "Шеф"
    text: "Русские из Брайтон-Бич просто так его фамилию не произносят."
    eventId:
  - speaker: "Шеф"
    text: "Твой старик знал слишком много. О ком именно — вот чего я пока не понимаю."
    eventId:
  - speaker: "Шеф"
    text: "По бумагам он приехал в восемьдесят девятом."
    eventId:
  - speaker: "Шеф"
    text: "А у меня есть снимок из Бруклина. Дата на обороте — октябрь восемьдесят седьмого."
    eventId:
  - speaker: "Шеф"
    text: "До Нью-Йорка он носил советскую форму. На том снимке у него другая фамилия."
    eventId:
  - speaker: "Шеф"
    text: "В девяносто четвёртом на него уже завели дело."
    eventId:
  - speaker: "Шеф"
    text: "Через неделю закрыли. Ни подписи, ни основания. Кто-то постарался."
    eventId:
  - speaker: "Шеф"
    text: "Я запросил оригинал. Прислали пустую папку. На обложке вмятина от скрепки. Бумаги вынули недавно."
    eventId:
  - speaker: "Шеф"
    text: "Он не просто пропал. Такие люди не пропадают."
    eventId:
  - speaker: "Шеф"
    text: "Кто-то вычеркнул его из журнала раньше, чем поступило заявление."
    eventId:
  - speaker: "Шеф"
    text: "Если тебе есть что добавить, сейчас самое время."
    eventId:
  - speaker: "Шеф"
    text: "Только учти: следующая фраза пойдёт в протокол."
    eventId:
